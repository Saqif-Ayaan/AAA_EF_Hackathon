# Copy this file to .env.local and fill in your keys. .env.local is gitignored —
# this repo is PUBLIC, so never put real keys in this example file.

# Required
ANTHROPIC_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=  # Apify Store actor that scrapes a LinkedIn profile URL without cookies, e.g. username/actor-name
OPENALEX_MAILTO=          # just your email address (OpenAlex asks for it; no key needed)

# Optional
GITHUB_TOKEN=             # raises GitHub API rate limits
OPENALEX_API_KEY=         # free key from openalex.org/settings/api; without it you share a small daily budget per IP
NEXT_PUBLIC_VAPI_PUBLIC_KEY=   # voice follow-up (browser-side, so it needs the NEXT_PUBLIC_ prefix)

# Local databases (defaults shown)
DATABASE_URL=file:local.db
MASTRA_DATABASE_URL=file:mastra.db
